/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate

/assets/face-detection-worker.mjs
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' https://cdn.jsdelivr.net; object-src 'none'
  Referrer-Policy: no-referrer

/install/keha-family-he.mobileconfig
  Content-Type: application/x-apple-aspen-config
  Content-Disposition: attachment; filename="keha-family-he.mobileconfig"
  Cache-Control: no-store
  X-Content-Type-Options: nosniff

/install/keha-family-en-US.mobileconfig
  Content-Type: application/x-apple-aspen-config
  Content-Disposition: attachment; filename="keha-family-en-US.mobileconfig"
  Cache-Control: no-store
