{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "family-yehuda",
  "main": "../worker.mjs",
  "compatibility_date": "2026-10-31",
  "workers_dev": true,
  "vars": {
    "FAMILY_BRANCH": "yehuda"
  },
  "services": [
    {
      "binding": "FAMILY_SITE",
      "service": "keha-family"
    }
  ]
}
