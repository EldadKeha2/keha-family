{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "keha-family",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-31",
  "workers_dev": true,
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/media/*",
      "/family-data.js",
      "/nakash/api/*",
      "/nakash/",
      "/nakash/index.html",
      "/keha-extended",
      "/keha-extended/",
      "/keha-extended/site-data.js",
      "/keha-extended/api/*",
      "/keha-extended/assets/*",
      "/keha-extended/privacy.html",
      "/keha-extended/shlomo",
      "/keha-extended/shlomo/",
      "/keha-extended/shlomo/site-data.js",
      "/keha-extended/shlomo/api/*",
      "/keha-extended/shlomo/assets/*",
      "/keha-extended/shlomo/privacy.html",
      "/keha-extended/zechariah",
      "/keha-extended/zechariah/",
      "/keha-extended/zechariah/site-data.js",
      "/keha-extended/zechariah/api/*",
      "/keha-extended/zechariah/assets/*",
      "/keha-extended/zechariah/privacy.html",
      "/keha-extended/zechariah-tzadok",
      "/keha-extended/zechariah-tzadok/",
      "/keha-extended/zechariah-tzadok/site-data.js",
      "/keha-extended/zechariah-tzadok/api/*",
      "/keha-extended/zechariah-tzadok/assets/*",
      "/keha-extended/zechariah-tzadok/privacy.html",
      "/keha-extended/kehat",
      "/keha-extended/kehat/",
      "/keha-extended/kehat/site-data.js",
      "/keha-extended/kehat/api/*",
      "/keha-extended/kehat/assets/*",
      "/keha-extended/kehat/privacy.html"
    ]
  },
  "durable_objects": {
    "code_update_strategy": {
      "mode": "deferred",
      "max_delay": 30
    },
    "bindings": [
      {
        "name": "FAMILY_STATE",
        "class_name": "FamilyState"
      },
      {
        "name": "FAMILY_UPDATES",
        "class_name": "FamilyUpdates"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "FamilyState"
      ]
    },
    {
      "tag": "v2-updates",
      "new_sqlite_classes": [
        "FamilyUpdates"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "vars": {
    "HF_BUCKET": "keha-family"
  },
  "build": {
    "command": "node scripts/build-pdf-assets.mjs && node scripts/build-site-styles.mjs && node scripts/build-face-picker.mjs && node scripts/build-family-fallback.mjs && node scripts/build-nakash-launch.mjs && node scripts/build-branch-portals.mjs && node scripts/build-android-launch.mjs && node scripts/prepare-family-apps.mjs"
  }
}
