{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "keha-family",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-31",
  "workers_dev": true,
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [{ "name": "FAMILY_STATE", "class_name": "FamilyState" }, { "name": "FAMILY_UPDATES", "class_name": "FamilyUpdates" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FamilyState"] }, { "tag": "v2-updates", "new_sqlite_classes": ["FamilyUpdates"] }],
  "triggers": { "crons": ["0 * * * *"] },
  "vars": {
    "HF_BUCKET": "keha-family"
  }
}
