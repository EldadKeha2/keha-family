# Local placeholders only. Set actual values as Cloudflare secrets/variables.
HF_ACCESS_KEY_ID=
HF_SECRET_ACCESS_KEY=
HF_NAMESPACE=
HF_BUCKET=keha-family
# Updates are disabled until a verified sender and the required secrets are configured.
UPDATES_ENABLED=false
SITE_ORIGIN=https://keha-family.eldadkeha.workers.dev
EMAIL_FROM=
